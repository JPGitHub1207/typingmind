# AI Influencer Tools - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# AI/LLM API Keys
# ===========================================

# OpenAI (for GPT-4 caption generation)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (alternative to OpenAI)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ===========================================
# Social Media Credentials
# ===========================================

# Instagram (use with caution - unofficial API)
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Twitter/X API (apply at developer.twitter.com)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# TikTok (limited API access)
TIKTOK_SESSION_ID=your_session_id

# ===========================================
# Image Generation
# ===========================================

# Midjourney (no official API - use through Discord)
# Requires separate setup with Discord bot

# Stability AI (for Stable Diffusion API)
STABILITY_API_KEY=sk-your-stability-key

# Replicate (various AI models)
REPLICATE_API_TOKEN=your_replicate_token

# ===========================================
# Other Services
# ===========================================

# ElevenLabs (voice generation)
ELEVENLABS_API_KEY=your_elevenlabs_key

# Cloudflare R2 or AWS S3 (media storage)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
S3_BUCKET_NAME=your_bucket_name

# ===========================================
# Application Settings
# ===========================================

# Database path (SQLite)
DATABASE_PATH=data/

# Content output path
CONTENT_OUTPUT_PATH=assets/

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone (for scheduling)
TIMEZONE=America/New_York
